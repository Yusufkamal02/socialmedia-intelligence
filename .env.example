# Shared secret between src/proxy.ts and /api/track (any long random string)
TRACK_SECRET=
# Optional: every visit (incl. IP) is POSTed here as JSON (Slack/Discord/n8n/Zapier webhook)
TRACK_WEBHOOK_URL=
# Optional: Telegram notifications (new visitors, ref= visits, quiz results, interest forms)
# Token from @BotFather; chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Basic-auth login for /admin (visitor monitor)
ADMIN_USER=admin
ADMIN_PASSWORD=
